// OpenClaw config for the Kimi K3.1 Pro x Cerebras hackathon entry.
// Installed to ~/.openclaw/openclaw.json by scripts/setup-openclaw.sh, which fills in __REPO__.
// Secrets are never stored here: they come from ~/.openclaw/.env
// (CEREBRAS_API_KEY, THERMITE_MCP_TOKEN, OPENCLAW_GATEWAY_TOKEN).
{
  gateway: {
    mode: "local",
    bind: "loopback",
    port: 18789,
    auth: { token: "${OPENCLAW_GATEWAY_TOKEN}" },
  },
  agents: {
    ownership: "explicit",
    defaults: {
      // The web chat opens on the shopper; pick "Mission control" in the agent menu.
      systemAgent: { agentId: "shopper" },
      model: { primary: "cerebras/moonshotai-kimi-k3.1-pro-trial" },
      // Cerebras queues requests for minutes at peak load; don't give up early.
      timeoutSeconds: 900,
      // As the official speed-patch config: Kimi on Cerebras at reasoning_effort low.
      thinkingDefault: "low",
    },
    entries: {
      // Lean agent for the demo: Thermite MCP tools only, no skills or bootstrap files,
      // so each request stays small under Cerebras tokens-per-minute limits.
      mission: {
        name: "Mission control",
        workspace: "__REPO__/agent",
        model: "cerebras/moonshotai-kimi-k3.1-pro-trial",
        skills: [],
        tools: { allow: ["thermite__*"], codeMode: false, swarm: false },
      },
      // Santa's Speedy Shopper: web search only. Its workspace is the Thermite-tuned
      // configuration (copy the champion's shopper/AGENTS.md into shopper/).
      shopper: {
        name: "Speedy Shopper",
        workspace: "__REPO__/shopper",
        model: "cerebras/moonshotai-kimi-k3.1-pro-trial",
        skills: [],
        tools: { allow: ["parallel__*"], codeMode: false, swarm: false },
      },
      // The same shopper (same workspace and tools) on Kimi K3.1 Pro served by GPUs, through
      // OpenRouter: its fastest provider by throughput, never Cerebras. For the side-by-side.
      // Needs OPENROUTER_API_KEY in ~/.openclaw/.env.
      "shopper-gpu": {
        name: "Speedy Shopper (GPU)",
        workspace: "__REPO__/shopper",
        model: "openrouter/moonshotai/kimi-k3.1-pro",
        params: { provider: { sort: "throughput", ignore: ["Cerebras"] } },
        skills: [],
        tools: { allow: ["parallel__*"], codeMode: false, swarm: false },
      },
    },
  },
  tools: { toolSearch: false },
  models: {
    mode: "merge",
    providers: {
      cerebras: {
        // Through scripts/tps_proxy.py --port 8897 (logs each call's decode speed and retries
        // Cerebras's platform-wide 429 queue_exceeded). Use https://api.cerebras.ai/v1 to go direct.
        baseUrl: "http://127.0.0.1:8897/v1",
        apiKey: "${CEREBRAS_API_KEY}",
        api: "openai-completions",
        models: [
          {
            id: "moonshotai-kimi-k3.1-pro-trial",
            name: "Kimi K3.1 Pro (Cerebras trial)",
            input: ["text", "image"],
            reasoning: true,
            compat: {
              supportsTools: true,
              supportsStrictMode: false,
              supportsReasoningEffort: true,
              supportedReasoningEfforts: ["low", "high", "max"],
            },
          },
          // Stand-in for pipeline tests until Kimi preview access is live.
          { id: "gpt-oss-120b", name: "gpt-oss-120b (Cerebras)", input: ["text"], reasoning: true },
        ],
      },
    },
  },
  mcp: {
    servers: {
      // Parallel's free, key-free search MCP (https://parallel.ai/customer-terms).
      parallel: {
        url: "https://search.parallel.ai/mcp",
        transport: "streamable-http",
        toolFilter: { include: ["web_search", "web_fetch"] },
      },
      thermite: {
        url: "http://127.0.0.1:8800/mcp",
        transport: "streamable-http",
        headers: { Authorization: "Bearer ${THERMITE_MCP_TOKEN}" },
        // All 68 tool schemas are ~33K tokens a turn (100K TPM cap), and the operator
        // token can start paid RunPod pods: expose only what mission control needs.
        toolFilter: {
          include: [
            "list_rigs", "get_run", "get_attempt", "run_queue", "recent_events",
            "leaderboard", "model_usage", "list_commands", "command_status",
            "issue_command", "start_run", "kits",
          ],
        },
      },
    },
  },
}
